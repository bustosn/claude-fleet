#!/bin/sh
# After `git merge` or `git pull` lands on main in the main checkout, rebuild and restart the daily instance.
# Enabled once per clone with: git config core.hooksPath scripts/hooks
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
[ "$(git rev-parse --git-dir)" = ".git" ] || exit 0   # linked worktrees have a .git file, not the directory
if [ "$(uname -s)" = Darwin ]; then
  # ship.ps1 -BuildOnly's steps minus the smoke test. Packages only when the lockfile moved, with Fleet stopped meanwhile.
  if ! git diff --quiet ORIG_HEAD HEAD -- package-lock.json 2>/dev/null || [ ! -d node_modules ]; then
    scripts/autostart.sh stop && npm install --no-audit --no-fund --loglevel=error || exit 1
  fi
  npm run build --silent || exit 1
  [ -f "$HOME/Library/LaunchAgents/com.fleet.plist" ] && exec scripts/autostart.sh restart
  exit 0
fi
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ship.ps1 -BuildOnly
