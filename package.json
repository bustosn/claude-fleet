{
  "name": "claude-fleet",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "description": "Local control room for Claude Code sessions, worktrees, agent-to-agent chat, and daily chores",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "node scripts/dev.js",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run build",
    "test": "node --import tsx --test server/*.test.ts",
    "setup": "node scripts/os.mjs setup",
    "restart": "node scripts/os.mjs restart",
    "ship": "node scripts/os.mjs ship",
    "desktop": "cd desktop && npm install && npm run dist"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "express": "^4.21.2",
    "highlight.js": "^11.12.0",
    "intelephense": "^1.18.5",
    "mysql2": "^3.24.6",
    "node-pty": "^1.1.0",
    "puppeteer-core": "^24.43.1",
    "pyright": "^1.1.414",
    "tsx": "^4.19.2",
    "typescript-language-server": "^6.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-virtual": "^3.14.25",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.9.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.5"
  }
}
